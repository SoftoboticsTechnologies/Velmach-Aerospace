-           'pinterest.', 'facebook.', 'instagram.', 'twitter.', 'x.com', 'tiktok.', 'youtube.', 'reddit.', 'aliexpress.',
-           'alibaba.', 'etsy.', 'walmart.', 'wish.com', 'temu.', 'craigslist.', 'lookaside.', 'fbsbx.', 'dhgate.',
