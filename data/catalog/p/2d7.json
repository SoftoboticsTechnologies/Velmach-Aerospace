tNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"images/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"0843500-28-link-upper-connecting":{"id":"vmc2138bc1efb5","slug":"0843500-28-link-upper-connecting","title":"LINK, UPPER CONNECTING","partNumber":"0843500-28","brand":"","brandSlug":"","categoryParent":"aircraft-parts","categoryChild":"","shortDescription":"LINK, UPPER CONNECTING, part number 0843500-28.","description":"<p>LINK, UPPER CONNECTING, part number 0843500-28.</p>","specifications":[{"name":"Rows in the lists","value":"3"},{"name":"Listed in","value":"Master Parts Inventory"}],"images":[],"documents":[],"compatibleAircraft":[],"condition":"AR","conditionCode":"AR","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"images/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"araldite-1641-a-b":{"id":"vmbb3f3f702fe4","slug":"araldite-1641-a-b","title":"Araldite 1641-A/B","partNumber":"","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"adhesives-compounds","shortDescription":"","description":"","specifications":[{"name":"Part no. (as written)","value":"Araldite, 1641 A/B, Adhesive"}],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:33+00:00","rails":{"rel":173}},"sealant-scrapers-polygonetm-300-ag-sealant-remover-polywipestm-150-wipes-per":{"id":"vma8665b8b1aab","slug":"sealant-scrapers-polygonetm-300-ag-sealant-remover-polywipestm-150-wipes-per","title":"SEALANT SCRAPERS POLYGONE™ 300-AG SEALANT REMOVER – PolyWipes™, 150 Wipes per Tub","partNumber":"PWAG","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"sealants","shortDescription":"","description":"<p>PolyGone™ 300-AG is a high performance aviation-grade sealant emulsifier in gel or liquid form designed to remove polysulfide and silicone sealants from a variety of materials and surfaces. PolyGone™ penetrates, breaks down and emulsifies cured sealants. Once broken down, sealant is suspended to prevent re-deposition and enable easy rinsing. The gel is suited for parts that cannot be immersed, vertical and inverted surfaces; the liquid is designed for parts that can be immersed such as clecos, fasteners, panel and tooling. PolyWipes™ are lint free wipes impregnated with PolyGone™ to remove un-cured sealant. Meets the requirements of Boeing D6-17487, except for ASTM Paint Softening and meets Douglas CSD #1, except for ASTM 484, Acrylic Crazing. PolyGone™ 300-AG is for use at room temperature, applied onto the target area. Agitation is needed every 30 minutes to remove the digested sealant and expose underlying layers. PolyGone™ 300- AG is metal-friendly, non-ionic and non-reactive however it attacks many types of polymers and plastics and should not be used in contact with acrylics, polyvinyl chloride (PVC), polyvinyl alcohol and similar plastics. Test for compatibility with other types of plastics. Polypropylene, Poly Olefin, Polyethylene, Teflon and Butyl Rubber are recommended for storage and application equipment.</p>","specifications":[],"images":[{"thumb":"images/products/PWAG/thumbs/PWAG-1.webp","large":"images/products/PWAG/display/PWAG-1.webp","original":"images/products/PWAG/PWAG-1.jpg"}],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T18:48:04+00:00","rails":{"rel":44}}}