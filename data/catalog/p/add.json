ory"}],"images":[],"documents":[],"compatibleAircraft":["gulfstream/giv"],"condition":"IN","conditionCode":"IN","altPartNumber":"","serialNumber":"","certification":"FAA Form 8130-3","aircraftListed":"Gulfstream GIV SN 1352","placeholder":"images/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"sealant-scrapers-polygonetm-300-ag-sealant-remover-gel-5-lb-bucket-pg310aggel5lb":{"id":"vm2016e61f997f","slug":"sealant-scrapers-polygonetm-300-ag-sealant-remover-gel-5-lb-bucket-pg310aggel5lb","title":"SEALANT SCRAPERS POLYGONE™ 300-AG SEALANT REMOVER – GEL, 5 LB Bucket","partNumber":"PG310AGGEL5LB","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"sealants","shortDescription":"","description":"<p>PolyGone™ 300-AG is a high performance aviation-grade sealant emulsifier in gel or liquid form designed to remove polysulfide and silicone sealants from a variety of materials and surfaces. PolyGone™ penetrates, breaks down and emulsifies cured sealants. Once broken down, sealant is suspended to prevent re-deposition and enable easy rinsing. The gel is suited for parts that cannot be immersed, vertical and inverted surfaces; the liquid is designed for parts that can be immersed such as clecos, fasteners, panel and tooling. PolyWipes™ are lint free wipes impregnated with PolyGone™ to remove un-cured sealant. Meets the requirements of Boeing D6-17487, except for ASTM Paint Softening and meets Douglas CSD #1, except for ASTM 484, Acrylic Crazing. PolyGone™ 300-AG is for use at room temperature, applied onto the target area. Agitation is needed every 30 minutes to remove the digested sealant and expose underlying layers. PolyGone™ 300- AG is metal-friendly, non-ionic and non-reactive however it attacks many types of polymers and plastics and should not be used in contact with acrylics, polyvinyl chloride (PVC), polyvinyl alcohol and similar plastics. Test for compatibility with other types of plastics. Polypropylene, Poly Olefin, Polyethylene, Teflon and Butyl Rubber are recommended for storage and application equipment.</p>","specifications":[],"images":[{"thumb":"images/products/PG310AGGEL5LB/thumbs/PG310AGGEL5LB-1.webp","large":"images/products/PG310AGGEL5LB/display/PG310AGGEL5LB-1.webp","original":"images/products/PG310AGGEL5LB/PG310AGGEL5LB-1.jpg"}],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T18:48:04+00:00","rails":{"rel":44}},"dykem-cross-check":{"id":"vm964d4013ab20","slug":"dykem-cross-check","title":"DYKEM CROSS-CHECK","partNumber":"","brand":"","brandSlug":"","categoryParent":"aircraft-parts","categoryChild":"seals-o-rings","shortDescription":"","description":"","specifications":[],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:27+00:00","rails":{"rel":310}}}