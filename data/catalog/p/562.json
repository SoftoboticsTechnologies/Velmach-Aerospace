s/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"01240-elec-trim-monitor":{"id":"vm939fcf994afb","slug":"01240-elec-trim-monitor","title":"ELEC TRIM MONITOR","partNumber":"01240","brand":"","brandSlug":"","categoryParent":"aircraft-parts","categoryChild":"","shortDescription":"ELEC TRIM MONITOR, part number 01240.","description":"<p>ELEC TRIM MONITOR, part number 01240.</p>","specifications":[{"name":"Rows in the lists","value":"4"},{"name":"Listed in","value":"Master Parts Inventory"}],"images":[],"documents":[],"compatibleAircraft":[],"condition":"AR, SV","conditionCode":"AR","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"images/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"sealant-scrapers-polygonetm-300-ag-sealant-remover-gel-35-lb-pail-pg300gel35lb":{"id":"vm19b6495f5378","slug":"sealant-scrapers-polygonetm-300-ag-sealant-remover-gel-35-lb-pail-pg300gel35lb","title":"SEALANT SCRAPERS POLYGONE™ 300-AG SEALANT REMOVER – GEL, 35 LB Pail","partNumber":"PG300GEL35LB","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"sealants","shortDescription":"","description":"<p>PolyGone™ 300-AG is a high performance aviation-grade sealant emulsifier in gel or liquid form designed to remove polysulfide and silicone sealants from a variety of materials and surfaces. PolyGone™ penetrates, breaks down and emulsifies cured sealants. Once broken down, sealant is suspended to prevent re-deposition and enable easy rinsing. The gel is suited for parts that cannot be immersed, vertical and inverted surfaces; the liquid is designed for parts that can be immersed such as clecos, fasteners, panel and tooling. PolyWipes™ are lint free wipes impregnated with PolyGone™ to remove un-cured sealant. Meets the requirements of Boeing D6-17487, except for ASTM Paint Softening and meets Douglas CSD #1, except for ASTM 484, Acrylic Crazing. PolyGone™ 300-AG is for use at room temperature, applied onto the target area. Agitation is needed every 30 minutes to remove the digested sealant and expose underlying layers. PolyGone™ 300- AG is metal-friendly, non-ionic and non-reactive however it attacks many types of polymers and plastics and should not be used in contact with acrylics, polyvinyl chloride (PVC), polyvinyl alcohol and similar plastics. Test for compatibility with other types of plastics. Polypropylene, Poly Olefin, Polyethylene, Teflon and Butyl Rubber are recommended for storage and application equipment.</p>","specifications":[],"images":[{"thumb":"images/products/PG300GEL35LB/thumbs/PG300GEL35LB-1.webp","large":"images/products/PG300GEL35LB/display/PG300GEL35LB-1.webp","original":"images/products/PG300GEL35LB/PG300GEL35LB-1.jpg"}],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T18:48:04+00:00","rails":{"rel":56}},"saint-gobain-sgk5-05":{"id":"vme0962c29a157","slug":"saint-gobain-sgk5-05","title":"SAINT GOBAIN SGK5-05","partNumber":"","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"tape","shortDescription":"","description":"","specifications":[],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:32+00:00","rails":{"rel":270}},"mankiewicz-celerol":{"id":"vm3570c8bc20d0","slug":"mankiewicz-celerol","title":"MANKIEWICZ CELEROL","partNumber":"","brand":"Mankiewicz","brandSlug":"mankiewicz","categoryParent":"consumables","categoryChild":"paints-coatings","shortDescription":"","description":"","specifications":[],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","a