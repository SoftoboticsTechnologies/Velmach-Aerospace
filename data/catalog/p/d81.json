nd":"","brandSlug":"","categoryParent":"aircraft-parts","categoryChild":"aircraft-batteries","shortDescription":"","description":"<p>ABATS is a computer aided battery maintenance tracking system that provides the user with the technology to accurately monitor and record individual cell voltages and water consumption during a NiCad service cycle. ABATS provides the same functionality and performance as our ADAS system, but with a new design and user interface and better data storage and reporting capabilities. ABATS accessary Provides repeatability and accuracy Automatically fills NiCad cell to proper level and records the amount of water added into the ABATS system Water data recorded in ABATS with time stamp and totalized on final report Data can be utilized to increase battery on-wing time, reducing maintenance costs Note: H20 accessory is not a stand alone system. Must interface with ABATS.</p>","specifications":[],"images":[{"thumb":"images/products/BS426/thumbs/BS426-1.webp","large":"images/products/BS426/display/BS426-1.webp","original":"images/products/BS426/BS426-1.jpg"}],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:27+00:00","rails":{"rel":253}},"stikittm-gold-dust-free-236u-c-weight-paper-stikittm-disc-6-inch-051141-55575":{"id":"vm38d2da1f7565","slug":"stikittm-gold-dust-free-236u-c-weight-paper-stikittm-disc-6-inch-051141-55575","title":"STIKIT™ GOLD DUST FREE 236U C WEIGHT PAPER – STIKIT™ DISC – 6 INCH – P220C","partNumber":"051141-55575","brand":"","brandSlug":"","categoryParent":"aircraft-tooling","categoryChild":"abrasives","shortDescription":"","description":"<p>Pressure sensitive backing. Pre-punched with standard hole pattern for dust-free sanding. 100 discs per roll.</p>","specifications":[{"name":"Grade","value":"P220C"}],"images":[{"thumb":"images/products/051141-55575/thumbs/05