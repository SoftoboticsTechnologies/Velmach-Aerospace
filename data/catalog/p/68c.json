Slug":"","categoryParent":"aircraft-parts","categoryChild":"","shortDescription":"TIP, part number 0731606-3.","description":"<p>TIP, part number 0731606-3.</p>","specifications":[{"name":"Listed in","value":"Master Parts Inventory"}],"images":[],"documents":[],"compatibleAircraft":[],"condition":"AR","conditionCode":"AR","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"images/placeholders/velmach-logo.png","sample":false,"updatedAt":"2026-11-03T14:11:34+00:00"},"perfect-ittm-3000-buffing-system-for-a-high-gloss-finish-rubbing-compound-gal":{"id":"vmea4b4599008e","slug":"perfect-ittm-3000-buffing-system-for-a-high-gloss-finish-rubbing-compound-gal","title":"PERFECT-IT™ 3000 BUFFING SYSTEM FOR A HIGH GLOSS FINISH – Rubbing Compound / GAL","partNumber":"051131-05974","brand":"","brandSlug":"","categoryParent":"consumables","categoryChild":"paints-coatings","shortDescription":"","description":"<p>Perfect-It™ 3000 is a full line of silicone-free buffing compounds and pads that produce a high gloss finish after the sanding process. These compounds and associated pads refine scratches and leave a smooth, high gloss finish. Ultrafina SE is capable of removing stubborn “halo” scratches from dark colors with clearcoats. Detailing cloths remove compounds from the paint surface and leave a glossy finish without introducing scratches. VOC compliant.</p>","specifications":[],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:31+00:00","rails":{"rel":120}},"3mtm-cubitrontm-ii-hookittm-clean-sanding-film-disc-775l-076308-64270":{"id":"vmf12e184913c0","slug":"3mtm-cubitrontm-ii-hookittm-clean-sanding-film-disc-775l-076308-64270","title":"3M™ CUBITRON™ II HOOKIT™ CLEAN SANDING FILM DISC 775L","partNumber":"076308-64270","brand":"3M","brandSlug":"3m","categoryParent":"aircraft-tooling","categoryChild":"abrasives","shortDescription":"","description":"<p>3M™ Cubitron™ II Hookit™ Clean Sanding Film Disc 775L features 3M Precision Shaped Ceramic Grain, a revolutionary advancement in abrasive technology. The triangular shaped ceramic mineral is designed to slice through the substrate, rather than gouging or “plowing” like conventional abrasives, resulting in a disc that cuts up to 2x as fast and lasts up to 6x as long as conventional abrasives</p>","specifications":[],"images":[],"documents":[],"compatibleAircraft":[],"condition":"New","conditionCode":"","altPartNumber":"","serialNumber":"","certification":"","aircraftListed":"","placeholder":"","sample":false,"updatedAt":"2026-10-13T13:40:25+00:00","rails":{"rel":293,"brand":414}}}